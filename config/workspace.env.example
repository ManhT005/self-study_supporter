# Isolated local preview. Use a private value before starting Docker.
WORKSPACE_DB_PASSWORD=replace-with-a-private-local-password
WORKSPACE_WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# Explicit local HTTP exception. HTTPS deployments must set true.
API_SECURE_COOKIE=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Optional provider credentials belong here/server env, never NEXT_PUBLIC_*.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GITHUB_TOKEN=
OPENROUTER_API_KEY=
