# Copy to .env.docker and DO NOT COMMIT secrets.
# Password is passed to SQLAlchemy URL.create(), including reserved characters.
POSTGRES_DB=study_supporter
POSTGRES_USER=study
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
APP_PORT=8501
# Host Ollama on Windows: http://host.docker.internal:11434
# Docker Ollama (--profile local-ai): http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Must match a model already installed in Ollama.
OLLAMA_MODEL=qwen2.5:1.5b
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GITHUB_TOKEN=
OPENROUTER_API_KEY=
